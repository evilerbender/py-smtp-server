# Python SMTP Server Configuration
# Choose either SQS (AWS) or Redis (non-AWS) architecture

# SMTP Server Settings
SMTP_HOST=0.0.0.0
SMTP_PORT=8025
LOG_LEVEL=INFO

# =============================================================================
# SQS ARCHITECTURE (AWS) - Choose this for AWS deployments
# =============================================================================
# Uncomment these lines for SQS+S3 architecture

# SMTP Server Processor (SQS+S3 Hybrid - recommended for production)
# EMAIL_PROCESSORS=[{"type": "sqs_s3_hybrid", "config": {"queue_url": "https://sqs.us-east-1.amazonaws.com/123456789012/email-queue", "s3_bucket": "my-email-storage-bucket", "s3_prefix": "emails/"}}]

# OR SMTP Server Processor (SQS only - legacy, size limited)
# EMAIL_PROCESSORS=[{"type": "sqs_queue", "config": {"queue_url": "https://sqs.us-east-1.amazonaws.com/123456789012/email-queue"}}]

# SQS Worker Configuration
# SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/email-queue

# =============================================================================
# REDIS ARCHITECTURE (NON-AWS) - Choose this for on-premise/non-AWS deployments
# =============================================================================
# Uncomment these lines for Redis architecture

# SMTP Server Processor (Redis Hybrid)
EMAIL_PROCESSORS=[{"type": "redis_hybrid", "config": {"redis_host": "localhost", "redis_port": 6379, "stream_name": "email_queue", "email_ttl": 86400}}]

# Redis Worker Configuration
REDIS_STREAM_NAME=email_queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_CONSUMER_GROUP=workers

# Optional Redis authentication (uncomment if needed)
# REDIS_PASSWORD=your_password
# REDIS_USERNAME=your_username
# REDIS_SSL=false

# =============================================================================
# WORKER PROCESSORS (FINAL PROCESSING) - Used by both architectures
# =============================================================================
# Configure how emails are finally processed after being queued

# Example: Save to local files
worker.processors.0.type=file_storage
worker.processors.0.storage_dir=/var/spool/mail/processed

# Example: Send via SMTP.com API (uncomment to use)
# worker.processors.0.type=smtpcom_api
# worker.processors.0.api_key=your_smtp_com_api_key
# worker.processors.0.channel=your_channel_name

# Example: Multiple processors (process through all)
# worker.processors.0.type=file_storage
# worker.processors.0.storage_dir=/var/spool/mail/processed
# worker.processors.1.type=smtpcom_api
# worker.processors.1.api_key=your_smtp_com_api_key
# worker.processors.1.channel=your_channel_name

# =============================================================================
# SYSTEMD SERVICE SELECTION
# =============================================================================
# After editing this file, enable the appropriate worker service:
#
# For SQS architecture:
#   sudo systemctl enable py-smtp-worker
#   sudo systemctl start py-smtp-server py-smtp-worker
#
# For Redis architecture:
#   sudo systemctl enable py-smtp-redis-worker
#   sudo systemctl start py-smtp-server py-smtp-redis-worker
#
# The SMTP server (py-smtp-server) is used by both architectures